{
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/ar/:path*",
      "destination": "/ar/:path*"
    },
    {
      "source": "/en/:path*",
      "destination": "/en/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
